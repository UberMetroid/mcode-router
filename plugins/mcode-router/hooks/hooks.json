{
  "enabled": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "OODA fleet context",
            "command": "mcode-router --status 2>/dev/null | head -40",
            "timeout": 8
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "OODA routing state",
            "command": "mcode-router --status 2>/dev/null | sed -n '/OODA Stage Routing Matrix/,$p'",
            "timeout": 8
          }
        ]
      }
    ]
  }
}
